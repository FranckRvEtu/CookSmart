{
  "functions": {
    "source": "functions",
    "predeploy": [
      "npm --prefix \"$RESOURCE_DIR\" run build"
    ]
  },
  "emulators": {
    "functions": {
      "host": "0.0.0.0",
      "port": 5001
    },
    "ui": {
      "enabled": true,
      "host": "0.0.0.0",
      "port": 4040
    },
    "hub": {
      "host": "0.0.0.0",
      "port": 4440
    }
  },
  "hosting": {
    "rewrites": [
      {
        "source": "/api/search",
        "function": "searchMarmitonRecipes"
      }
    ]
  }
}
